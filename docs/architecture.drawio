<mxfile host="app.diagrams.net"><diagram name="Azure Disk Monitoring" id="azure-disk-monitoring"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="810" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="mg" value="&lt;b&gt;Management Group (root of all subscriptions)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d98a00;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#8a5600;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="960" height="110" as="geometry"/></mxCell><mxCell id="rbac" value="&lt;b&gt;Custom RBAC role: Disk Monitoring Operator&lt;/b&gt;&lt;br&gt;assigned once here, inherited by all subscriptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="95" width="380" height="55" as="geometry"/></mxCell><mxCell id="pol" value="&lt;b&gt;Azure Policy (DeployIfNotExists)&lt;/b&gt;&lt;br&gt;assigned once here, covers new + existing VMs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="95" width="380" height="55" as="geometry"/></mxCell><mxCell id="cen" value="&lt;b&gt;Central Monitoring Subscription&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#3b6fd4;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1d4fa8;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="460" height="450" as="geometry"/></mxCell><mxCell id="ans" value="&lt;b&gt;Ansible Control Node&lt;/b&gt;&lt;br&gt;VM with Managed Identity (no passwords)&lt;br&gt;Playbooks kept in Git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="380" height="75" as="geometry"/></mxCell><mxCell id="arg" value="&lt;b&gt;Azure Resource Graph&lt;/b&gt;&lt;br&gt;one query lists VMs in ALL subscriptions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="380" height="55" as="geometry"/></mxCell><mxCell id="law" value="&lt;b&gt;Log Analytics Workspace (central)&lt;/b&gt;&lt;br&gt;Perf + Heartbeat tables&lt;br&gt;all subscriptions write here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="380" height="80" as="geometry"/></mxCell><mxCell id="wb" value="&lt;b&gt;Dashboard /&lt;/b&gt;&lt;br&gt;Workbook (KQL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="110" height="55" as="geometry"/></mxCell><mxCell id="alr" value="&lt;b&gt;Alert rules&lt;/b&gt;&lt;br&gt;80% / 90% / silent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="195" y="560" width="110" height="55" as="geometry"/></mxCell><mxCell id="ag" value="&lt;b&gt;Action Group&lt;/b&gt;&lt;br&gt;email / Teams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="560" width="110" height="55" as="geometry"/></mxCell><mxCell id="ops" value="&lt;b&gt;Ops team&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=13;" vertex="1" parent="1"><mxGeometry x="285" y="660" width="200" height="40" as="geometry"/></mxCell><mxCell id="wl" value="&lt;b&gt;Workload Subscriptions (many)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1faf1;strokeColor=#2f8f3a;strokeWidth=2;verticalAlign=top;fontSize=14;fontColor=#1e6b27;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="460" height="450" as="geometry"/></mxCell><mxCell id="vm" value="&lt;b&gt;Linux VMs + Azure Monitor Agent&lt;/b&gt;&lt;br&gt;system managed identity&lt;br&gt;no SSH, no open ports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="230" width="380" height="75" as="geometry"/></mxCell><mxCell id="dcr" value="&lt;b&gt;Data Collection Rule (DCR)&lt;/b&gt;&lt;br&gt;collects &amp;quot;% Used Space&amp;quot; every 5 minutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="340" width="380" height="65" as="geometry"/></mxCell><mxCell id="more" value="&lt;b&gt;Subscription A, B, C ... (more later)&lt;/b&gt;&lt;br&gt;nothing to change when one is added" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="440" width="380" height="60" as="geometry"/></mxCell><mxCell id="leg" value="&lt;b&gt;How it flows&lt;/b&gt;&lt;br&gt;1  Ansible finds VMs in all subscriptions&lt;br&gt;2  Policy installs the agent + links the DCR automatically&lt;br&gt;3  Ansible audits / enrolls missed VMs, optional read-only df&lt;br&gt;4  Agent sends disk % used to the central workspace&lt;br&gt;5  Alert rule fires -&amp;gt; Action Group -&amp;gt; Ops team&lt;br&gt;6  Dashboard / Workbook shows the fullest disks" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#999999;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="660" width="460" height="135" as="geometry"/></mxCell><mxCell id="e1" value="access" style="endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=13;fontStyle=1;fontColor=#c00000;" edge="1" parent="1" source="rbac" target="ans"><mxGeometry relative="1" as="geometry"><mxPoint x="22" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="2" style="endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=13;fontStyle=1;fontColor=#c00000;" edge="1" parent="1" source="pol" target="vm"><mxGeometry relative="1" as="geometry"><mxPoint x="22" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="1" style="endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=13;fontStyle=1;fontColor=#c00000;" edge="1" parent="1" source="ans" target="arg"><mxGeometry relative="1" as="geometry"><mxPoint x="22" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="3" style="endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=13;fontStyle=1;fontColor=#c00000;" edge="1" parent="1" source="ans" target="vm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="config" style="endArrow=block;endFill=1;html=1;strokeWidth=2;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=13;fontStyle=1;fontColor=#c00000;" edge="1" parent="1" source="dcr" target="vm"><mxGeometry relative="1" as="geometry"><mxPoint x="22" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="4" style="endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=13;fontStyle=1;fontColor=#c00000;" edge="1" parent="1" source="vm" target="law"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="6" style="endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=0.1447;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=13;fontStyle=1;fontColor=#c00000;" edge="1" parent="1" source="law" target="wb"><mxGeometry relative="1" as="geometry"><mxPoint x="22" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e8" value="5" style="endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=13;fontStyle=1;fontColor=#c00000;" edge="1" parent="1" source="law" target="alr"><mxGeometry relative="1" as="geometry"><mxPoint x="22" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="e9" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=13;fontStyle=1;fontColor=#c00000;" edge="1" parent="1" source="alr" target="ag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=13;fontStyle=1;fontColor=#c00000;" edge="1" parent="1" source="ag" target="ops"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>